# Web3Forms access key — https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# OpenAI — server only, never NEXT_PUBLIC
OPENAI_API_KEY=
# Optional. Only gpt-4o-mini is allowed; anything else falls back to gpt-4o-mini
OPENAI_MODEL=

# Set to false to disable chat without removing other keys
CHAT_ENABLED=true

# Cloudflare Turnstile (bot protection for chat)
# Site key is passed from the server into the chat UI (still visible in the browser — that is how Turnstile works).
# Secret key stays server-only and must never use NEXT_PUBLIC_.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Upstash Redis — durable chat rate limits (shared across Vercel instances)
# Create a free Redis DB at https://console.upstash.com → REST API → copy URL + token
# Required in production when chat/OpenAI is enabled
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
